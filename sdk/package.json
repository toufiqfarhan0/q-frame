{
  "name": "q-frame-sdk",
  "version": "0.1.0",
  "description": "Post-Quantum EIP-8250 Keyed Nonce Client SDK for EIP-8141 Frame Transactions & ERC-8421 Mempools",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ethereum",
    "post-quantum",
    "eip-8141",
    "eip-8250",
    "erc-8421",
    "frame-transactions",
    "keyed-nonces",
    "wots",
    "staked-mempool"
  ],
  "author": "Toufiq Farhan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toufiqfarhan0/q-frame.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/toufiqfarhan0/q-frame/issues"
  },
  "homepage": "https://github.com/toufiqfarhan0/q-frame#readme",
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "viem": "^2.23.0"
  }
}
